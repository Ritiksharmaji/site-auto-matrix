DATABASE_URL="postgresql://USER@localhost:5432/site_platform"
AUTH_SECRET="generate with: openssl rand -hex 32"
PLATFORM_HOST="localhost:3000"
SEED_PASSWORD="password used for seeded test accounts"

# Where uploaded images are stored on disk
UPLOAD_DIR="storage/uploads"

# Email (optional). Without SMTP_HOST, emails are recorded but not sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Site Platform <no-reply@yourplatform.com>"

# WhatsApp Cloud API (optional). Without these, WhatsApp alerts are recorded but not sent.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved template name for business-initiated alerts (recommended)
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"

# Protects /api/cron/billing (send as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET="generate with: openssl rand -hex 24"

# Client sites are <slug>.SITE_BASE_DOMAIN (defaults to PLATFORM_HOST). Production: onekampus.com
# SITE_BASE_DOMAIN="onekampus.com"
# Extra subdomains no client may use (other apps on the same domain)
# RESERVED_SUBDOMAINS="music,music-admin,music-api"

# Code websites (React / Next.js / HTML edited in VS Code, built by GitHub Actions).
# Without these, the "Code website" option is shown but disabled. See docs/DEPLOYMENT.md.
# GITHUB_TOKEN=""            fine-grained token (repos site-*: Administration, Contents, Workflows, Webhooks, Actions)
# GITHUB_OWNER="Ritiksharmaji"
# GITHUB_WEBHOOK_SECRET=""   generate with: openssl rand -hex 32
# Where builds are stored (default storage/code-sites; the server uses /data/code-sites)
# CODE_SITES_DIR=""
