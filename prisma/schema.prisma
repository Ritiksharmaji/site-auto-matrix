// Site Platform data model.
// Structured data (users, clients, sites, permissions) lives in tables;
// flexible per-module data (theme, section content) lives in JSONB columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STAFF
  CLIENT
}

enum SiteStatus {
  DRAFT
  PUBLISHED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum Channel {
  EMAIL
  WHATSAPP
}

enum DeliveryStatus {
  SENT
  FAILED
  /// Channel not configured (e.g. no SMTP in development) — message recorded only
  LOGGED
}

model User {
  id                String        @id @default(cuid())
  name              String
  email             String        @unique
  passwordHash      String
  role              Role
  isActive          Boolean       @default(true)
  /// Staff limits: { maxClients, canPublish, canDeleteClients, allowedModules }
  permissions       Json          @default("{}")
  /// Set for CLIENT users: the business they belong to
  clientId          String?
  client            Client?       @relation("ClientUsers", fields: [clientId], references: [id], onDelete: Cascade)
  createdById       String?
  createdBy         User?         @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers      User[]        @relation("UserCreatedBy")
  clientsOwned      Client[]      @relation("ClientOwner")
  activity          Activity[]
  assignedEnquiries Enquiry[]     @relation("EnquiryAssignee")
  enquiryNotes      EnquiryNote[]
  uploads           Asset[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Client {
  id           String       @id @default(cuid())
  name         String
  contactName  String
  email        String
  phone        String?
  notes        String?
  /// Billing plan (managed by the super admin). Amounts are in paise.
  planName     String?
  planAmount   Int?
  billingCycle BillingCycle @default(MONTHLY)
  nextDueDate  DateTime?
  invoices     Invoice[]
  /// The super admin or staff member who manages this client
  ownerId      String
  owner        User         @relation("ClientOwner", fields: [ownerId], references: [id])
  users        User[]       @relation("ClientUsers")
  sites        Site[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([ownerId])
}

model Site {
  id              String     @id @default(cuid())
  clientId        String
  client          Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String
  /// Used for the subdomain: <slug>.yourplatform.com
  slug            String     @unique
  customDomain    String?    @unique
  /// Module key from src/modules (e.g. "school", "company")
  moduleKey       String
  /// Ordered list of enabled section keys
  enabledSections Json       @default("[]")
  theme           Json       @default("{}")
  /// { brand: {...}, [sectionKey]: {...} }
  content         Json       @default("{}")
  status          SiteStatus @default(DRAFT)
  publishedAt     DateTime?
  /// Notification + auto-reply settings, see src/lib/automation.ts
  automation      Json       @default("{}")
  enquiries       Enquiry[]
  assets          Asset[]
  pageViews       PageView[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([clientId])
}

/// Form submissions from public sites (admission enquiries, contact leads)
model Enquiry {
  id            String         @id @default(cuid())
  siteId        String
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  formType      String
  name          String
  email         String?
  phone         String?
  message       String?
  status        EnquiryStatus  @default(NEW)
  assignedToId  String?
  assignedTo    User?          @relation("EnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes         EnquiryNote[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([siteId, createdAt])
  @@index([status])
}

model EnquiryNote {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())

  @@index([enquiryId])
}

/// Every automated message the platform sends (or would send, when a channel is not configured)
model Notification {
  id        String         @id @default(cuid())
  enquiryId String?
  enquiry   Enquiry?       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  channel   Channel
  recipient String
  subject   String?
  body      String
  status    DeliveryStatus
  error     String?
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

/// Uploaded images (logos, photos). Files live on disk in UPLOAD_DIR.
model Asset {
  id           String   @id @default(cuid())
  siteId       String?
  site         Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  filename     String
  storedName   String   @unique
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  number         String        @unique
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description    String
  /// Amount in paise
  amount         Int
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime
  status         InvoiceStatus @default(UNPAID)
  paidAt         DateTime?
  paymentNote    String?
  lastReminderAt DateTime?
  createdAt      DateTime      @default(now())

  @@index([status, dueDate])
  @@index([clientId])
}

/// One row per public page view. No IPs are stored; visitorHash is a daily-rotating hash.
model PageView {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  path        String
  referrer    String?
  visitorHash String
  createdAt   DateTime @default(now())

  @@index([siteId, createdAt])
}
