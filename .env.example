DATABASE_URL="postgresql://USER@localhost:5432/site_platform"
AUTH_SECRET="generate with: openssl rand -hex 32"
PLATFORM_HOST="localhost:3000"
SEED_PASSWORD="password used for seeded test accounts"

# Where uploaded images are stored on disk
UPLOAD_DIR="storage/uploads"

# Email (optional). Without SMTP_HOST, emails are recorded but not sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Site Platform <no-reply@yourplatform.com>"

# WhatsApp Cloud API (optional). Without these, WhatsApp alerts are recorded but not sent.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved template name for business-initiated alerts (recommended)
WHATSAPP_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="en"
